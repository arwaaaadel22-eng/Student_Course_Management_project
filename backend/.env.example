# ==============================================================================
# Student Course Management System - Backend Environment Configuration
# ==============================================================================
# Copy this file to '.env' and update the values for your local or production environment.
#
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTE:
# Never commit your active '.env' file or any real production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# The port on which the Express HTTP server will listen.
# Default: 3000
PORT=3000

# Node environment mode: 'development', 'production', or 'test'
# Default: development
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# MongoDB connection URI string.
# Examples:
#   Local:      mongodb://127.0.0.1:27017/DBFinalProject
#   Docker:     mongodb://mongo:27017/student_course_db
#   Atlas/Prod: mongodb+srv://<username>:<password>@cluster.mongodb.net/production_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/DBFinalProject

# ------------------------------------------------------------------------------
# 3. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# Cryptographic secret key used to sign and verify JSON Web Tokens.
# SECURITY REQUIREMENT:
# In production, use a high-entropy random string of at least 256 bits (32+ bytes).
# You can generate a strong random secret using OpenSSL or Node.js:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_secure_long_random_secret_key_minimum_32_characters

# Token lifespan before expiration (e.g., '1h', '1d', '7d').
# Recommended: '1d' or '7d' for standard sessions.
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Allowed origins for browser client communication.
# For multiple origins in production, specify comma-separated list or exact client domain.
# Default for Angular dev server: http://localhost:4200
CORS_ORIGIN=http://localhost:4200

# ------------------------------------------------------------------------------
# 5. Rate Limiting
# ------------------------------------------------------------------------------
# Max authentication requests per IP window (15 minutes).
# Default: 20
RATE_LIMIT_AUTH_MAX=20
