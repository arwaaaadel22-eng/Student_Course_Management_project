# ==============================================================================
# Git Ignore - Student Course Management System
# ==============================================================================

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Environment files & secrets (SECURITY: keep .env.example tracked)
**/.env
**/.env.*
!**/.env.example
**/config.env
tokens.txt

# Production & Build outputs
dist/
frontend/dist/
.angular/
frontend/.angular/
tmp/
out-tsc/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE & Editor configurations
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.history/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
